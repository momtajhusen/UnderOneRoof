{
  "expo": {
    "name": "Under One Roof",
    "slug": "under-one-roof",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "android": {
      "package": "com.underoneroof.underoneroof",
      "icon": "./assets/auth/applogo.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/auth/applogo.png",
        "backgroundColor": "#fffb00"
      }
    },
    "ios": {
      "bundleIdentifier": "com.underoneroof.underoneroof",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSExceptionDomains": {
            "u1rfoods.com": {
              "NSIncludesSubdomains": true,
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSExceptionRequiresForwardSecrecy": false
            }
          }
        }
      }
    },
    "extra": {
      "eas": {
        "projectId": "251e2151-022b-465a-80c7-311317bc1ea5"
      }
    },
    "splash": {
      "image": "./assets/auth/applogo.png",
      "backgroundColor": "#fffb00",
      "resizeMode": "contain"
    },
    "owner": "technicalmaithili",
    "experiments": {
      "newArchEnabled": true
    },
    "plugins": [
      "expo-video",
      "react-native-video"
    ]
  }
}
